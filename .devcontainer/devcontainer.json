{
  "name": "RUNNER ADVENTURE 3D — Godot 4.4.1",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["geequlim.godot-tools"]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-godot.sh",
  "remoteUser": "vscode"
}
